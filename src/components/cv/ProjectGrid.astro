---
import ProjectCard from "./ProjectCard.astro";

export interface ProjectSummary {
  title: string;
  description: string;
  tags: string[];
  link: string;
}

// Grid of project cards: two columns, or three on wide screens.
interface Props {
  projects: ProjectSummary[];
  columns?: 2 | 3;
}

const { projects, columns = 2 } = Astro.props;
---

<div class:list={["grid grid-cols-1 gap-6 md:grid-cols-2", columns === 3 && "lg:grid-cols-3"]}>
  {projects.map((project) => <ProjectCard {...project} />)}
</div>
