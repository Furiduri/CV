---
import Card from "../ui/Card.astro";

// Project summary that links to the project.
interface Props {
  title: string;
  description: string;
  link: string;
  tags?: string[];
}

const { title, description, link, tags = [] } = Astro.props;
---

<Card as="a" href={link} interactive class="group block h-full text-inherit no-underline">
  <h3 class="mt-0 transition-colors duration-300 group-hover:text-brand-neon">{title}</h3>
  <p class="mb-6 text-zinc-300">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full border border-brand-base/20 bg-brand-base/10 px-3 py-1 text-sm text-brand-neon">
          {tag}
        </span>
      ))}
    </div>
  )}
</Card>
