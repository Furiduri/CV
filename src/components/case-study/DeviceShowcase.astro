---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Desktop screenshot in a browser frame with the mobile screenshot in a phone
// frame overlapping its lower right corner.
interface Props {
  host: string;
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  desktopAlt: string;
  mobileAlt: string;
}

const { host, desktop, mobile, desktopAlt, mobileAlt } = Astro.props;
---

<div class="relative mb-20 pr-10 sm:pr-24 lg:pr-36">
  <figure class="m-0 overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 shadow-2xl shadow-black/60">
    <div aria-hidden="true" class="flex items-center gap-2 border-b border-white/10 bg-zinc-900 px-4 py-3">
      <span class="h-3 w-3 rounded-full bg-zinc-700"></span>
      <span class="h-3 w-3 rounded-full bg-zinc-700"></span>
      <span class="h-3 w-3 rounded-full bg-zinc-700"></span>
      <span class="ml-3 w-full max-w-xs truncate rounded-md bg-zinc-800 px-3 py-1 text-xs text-zinc-300">{host}</span>
    </div>
    <Image src={desktop} widths={[640, 960, 1440]} sizes="(min-width: 1152px) 920px, 85vw" alt={desktopAlt} class="block h-auto w-full" />
  </figure>
  <div class="absolute -bottom-10 right-0 w-24 overflow-hidden rounded-[1.75rem] border-4 border-zinc-800 bg-zinc-800 shadow-2xl shadow-black/70 sm:w-40 lg:w-48">
    <Image
      src={mobile}
      widths={[200, 400]}
      sizes="(min-width: 1024px) 192px, (min-width: 640px) 160px, 96px"
      alt={mobileAlt}
      class="block h-auto w-full rounded-[1.4rem]"
    />
  </div>
</div>
