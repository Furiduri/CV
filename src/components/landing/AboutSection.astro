---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Section from "../ui/Section.astro";
import type { Dictionary } from "../../i18n/types";

interface Props {
  id: string;
  copy: Dictionary["landing"]["about"];
  avatarSrc: string;
  cvHref: string;
}

const { id, copy, avatarSrc, cvHref } = Astro.props;
const headingId = `${id}-title`;
---

<Section id={id} labelledby={headingId}>
  <Card class="flex flex-col items-center gap-8 text-center md:flex-row md:items-start md:text-left">
    <div class="relative shrink-0">
      <div aria-hidden="true" class="absolute -inset-1 rounded-full bg-gradient-to-r from-brand-base to-brand-neon opacity-25 blur"></div>
      <div class="relative flex h-32 w-32 items-center justify-center overflow-hidden rounded-full border-4 border-zinc-900 bg-zinc-800 p-4 shadow-2xl md:h-40 md:w-40">
        <img src={avatarSrc} alt={copy.avatarAlt} width="128" height="128" class="h-full w-full object-contain" loading="lazy" />
      </div>
    </div>
    <div>
      <SectionHeading id={headingId} accent={false}>{copy.title}</SectionHeading>
      <p class="mb-4 text-lg text-zinc-200">{copy.intro}</p>
      <p class="mb-8 text-zinc-300">
        <strong class="text-zinc-50">{copy.missionLabel}:</strong> {copy.mission}
      </p>
      <Button href={cvHref} variant="secondary">{copy.cvLink}</Button>
    </div>
  </Card>
</Section>
