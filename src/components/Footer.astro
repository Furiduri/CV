---
import Icon from "./Icon.astro";
import GradientText from "./ui/GradientText.astro";
import SocialLinks from "./ui/SocialLinks.astro";
import { business, businessPlaceholders, mailtoUrl, whatsappUrl } from "../data/business";
import { socialLinks } from "../data/profile";
import { format, getLocalizedUrl, resolveLocale, useTranslations } from "../i18n/utils";

interface Props {
  // "cv": personal links (GitHub, LinkedIn...). "landing": GCatcode contact
  // details (landing and legal pages).
  variant?: "cv" | "landing";
}

const { variant = "cv" } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
const siteLinks = [
  { href: getLocalizedUrl(locale), label: t.footer.home },
  { href: getLocalizedUrl(locale, "cv"), label: t.footer.cv },
  { href: getLocalizedUrl(locale, "terminos"), label: t.footer.terms },
  { href: getLocalizedUrl(locale, "privacidad"), label: t.footer.privacy },
];
const generalWhatsappUrl = whatsappUrl(format(t.landing.whatsappMessages.general, businessPlaceholders));
---

<footer class="text-center py-16 border-t border-white/10 mt-16 text-zinc-300">
  <div class="container flex flex-col items-center gap-8">
    {variant === "landing" ? (
      <Fragment>
        <div>
          <p class="font-heading font-black text-2xl text-zinc-100 mb-1">G<GradientText>Catcode</GradientText></p>
          <p class="mb-1">{t.footer.tagline}</p>
          <p class="flex items-center justify-center gap-1 text-sm">
            <Icon name="mapPin" class="w-4 h-4" />
            {business.location}
          </p>
        </div>
        <ul class="flex flex-col sm:flex-row justify-center gap-4 sm:gap-8 list-none m-0 p-0">
          <li>
            <a href={generalWhatsappUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-zinc-300 hover:text-brand-neon">
              <Icon name="chat" class="w-5 h-5" />
              {t.footer.whatsapp}: {business.phoneDisplay}
              <span class="sr-only"> {t.landing.newTabNote}</span>
            </a>
          </li>
          <li>
            <a href={mailtoUrl} class="inline-flex items-center gap-2 text-zinc-300 hover:text-brand-neon">
              <Icon name="envelope" class="w-5 h-5" />
              {t.footer.email}: {business.email}
            </a>
          </li>
        </ul>
      </Fragment>
    ) : (
      <SocialLinks links={socialLinks} gap="wide" class="justify-center text-zinc-300" />
    )}
    <nav aria-label={t.footer.legalNav}>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 list-none m-0 p-0 text-sm">
        {siteLinks.map(({ href, label }) => (
          <li><a href={href} class="text-zinc-300 hover:text-brand-neon">{label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="m-0 text-sm">
      {variant === "landing"
        ? `© ${year} ${business.brand} · ${business.legalName}. ${t.footer.rights}`
        : `© ${year} Jorge Osvaldo Perez Mendoza. ${t.footer.builtWith}`}
    </p>
  </div>
</footer>
