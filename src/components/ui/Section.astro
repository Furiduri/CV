---
// Page section with the site container. `band` adds the full-bleed tinted
// background that alternates the rhythm of a long page; `compact` reduces the
// vertical padding for pages that stack many short sections (the CV). The
// `background` slot holds decorative layers (glows, photos) behind the content.
interface Props {
  id?: string;
  labelledby: string;
  tone?: "plain" | "band";
  spacing?: "default" | "compact";
  narrow?: boolean;
}

const { id, labelledby, tone = "plain", spacing = "default", narrow = false } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[
    "relative overflow-hidden",
    tone === "band" && "border-y border-white/5 bg-zinc-900/60",
    spacing === "compact" && "py-8",
  ]}
>
  <slot name="background" />
  <div class:list={["container relative", narrow && "max-w-4xl"]}>
    <slot />
  </div>
</section>
