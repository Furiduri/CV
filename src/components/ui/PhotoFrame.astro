---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Rounded frame that crops a photo to the frame's size. The caller sets the
// aspect ratio or height through `class`. `shade` darkens the bottom edge so
// overlaid chips stay readable.
interface Props {
  image: { src: string | ImageMetadata; width?: number; height?: number };
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  shade?: boolean;
  class?: string;
}

const { image, alt, widths, sizes, loading = "lazy", fetchpriority, shade = false, class: className } = Astro.props;
---

<div class:list={["relative overflow-hidden rounded-3xl border border-white/10 bg-zinc-900 shadow-2xl shadow-black/50", className]}>
  <Image
    src={image.src}
    width={image.width}
    height={image.height}
    widths={widths}
    sizes={sizes}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    class="absolute inset-0 h-full w-full object-cover"
  />
  {shade && <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent"></div>}
</div>
