---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div class="inline-block bg-zinc-900/70 border border-white/10 px-4 py-2 rounded-lg font-medium transition-all duration-300 hover:border-brand-base hover:bg-brand-base/10 hover:text-brand-neon hover:-translate-y-0.5">
  {name}
</div>
