---
import Icon, { type IconName } from "../Icon.astro";

// Link styled as a button. `primary` is the green call to action (dark text on
// brand-neon, APCA Lc ~72); `secondary` is a neutral outline. Passing
// `newTabLabel` opens the link in a new tab and announces it to screen readers.
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  size?: "md" | "sm";
  icon?: IconName;
  newTabLabel?: string;
  class?: string;
}

const { href, variant = "primary", size = "md", icon, newTabLabel, class: className } = Astro.props;

const sizes = {
  md: "px-6 py-3 text-sm tracking-wide sm:text-base sm:tracking-wider",
  sm: "px-4 py-2 text-xs tracking-wider",
};
const variants = {
  primary: "bg-brand-neon text-zinc-950 hover:-translate-y-0.5 hover:text-zinc-950 hover:shadow-lg hover:shadow-brand-neon/30",
  secondary: "border border-zinc-500 text-zinc-50 hover:border-brand-neon hover:bg-brand-neon/10 hover:text-brand-neon",
};
---

<a
  href={href}
  target={newTabLabel ? "_blank" : undefined}
  rel={newTabLabel ? "noopener" : undefined}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-lg text-center font-heading font-bold uppercase no-underline transition-all duration-300 hover:drop-shadow-none",
    sizes[size],
    variants[variant],
    className,
  ]}
>
  {icon && <Icon name={icon} class="h-5 w-5 shrink-0" />}
  <slot />
  {newTabLabel && <span class="sr-only"> {newTabLabel}</span>}
</a>
