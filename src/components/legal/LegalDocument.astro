---
import GradientText from "../ui/GradientText.astro";
import TextLink from "../ui/TextLink.astro";
import type { Dictionary, LegalDocument } from "../../i18n/types";

// Legal document (terms, privacy notice). Presentational (ADR-0001): the page
// passes the formatted document, the shared labels and the links.
interface Props {
  document: LegalDocument;
  labels: Pick<Dictionary["legal"], "updatedLabel" | "updatedDate" | "prevailNote" | "backHome">;
  // ISO date of the last revision, for the <time> element.
  updatedIso: string;
  homeHref: string;
}

const { document, labels, updatedIso, homeHref } = Astro.props;
---

<article class="max-w-3xl mx-auto">
  <header class="mb-12">
    <h1 class="text-4xl md:text-5xl"><GradientText>{document.heading}</GradientText></h1>
    <p class="text-sm text-zinc-300 m-0">
      {labels.updatedLabel} <time datetime={updatedIso}>{labels.updatedDate}</time>
    </p>
    <p class="text-sm text-zinc-300 mt-2">{labels.prevailNote}</p>
    <p class="text-lg text-zinc-300 mt-6">{document.intro}</p>
  </header>

  <ol class="list-none m-0 p-0 flex flex-col gap-10">
    {document.sections.map((section, index) => (
      <li>
        <section class="py-0">
          <h2 class="text-2xl md:text-3xl">
            <span class="text-brand-base">{index + 1}.</span> {section.title}
          </h2>
          <div class="flex flex-col gap-4 text-zinc-300">
            {section.blocks.map((block) =>
              typeof block === "string" ? (
                <p class="m-0">{block}</p>
              ) : (
                <ul class="list-disc pl-6 m-0 space-y-2">
                  {block.map((item) => <li>{item}</li>)}
                </ul>
              ),
            )}
          </div>
        </section>
      </li>
    ))}
  </ol>

  <p class="mt-16">
    <TextLink href={homeHref}>&larr; {labels.backHome}</TextLink>
  </p>
</article>
