---
import { businessPlaceholders, legalLastUpdated } from "../data/business";
import type { LegalDocument } from "../i18n/types";
import { format, getLocalizedUrl, resolveLocale, useTranslations } from "../i18n/utils";

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const f = (text: string) => format(text, businessPlaceholders);
---

<article class="max-w-3xl mx-auto">
  <header class="mb-12">
    <h1 class="text-4xl md:text-5xl"><span class="text-gradient">{document.heading}</span></h1>
    <p class="text-sm text-zinc-400 m-0">
      {t.legal.updatedLabel} <time datetime={legalLastUpdated}>{t.legal.updatedDate}</time>
    </p>
    <p class="text-sm text-zinc-400 mt-2">{t.legal.prevailNote}</p>
    <p class="text-lg text-zinc-300 mt-6">{f(document.intro)}</p>
  </header>

  <ol class="list-none m-0 p-0 flex flex-col gap-10">
    {document.sections.map((section, index) => (
      <li>
        <section class="py-0">
          <h2 class="text-2xl md:text-3xl">
            <span class="text-brand-base">{index + 1}.</span> {section.title}
          </h2>
          <div class="flex flex-col gap-4 text-zinc-300">
            {section.blocks.map((block) =>
              typeof block === "string" ? (
                <p class="m-0">{f(block)}</p>
              ) : (
                <ul class="list-disc pl-6 m-0 space-y-2">
                  {block.map((item) => <li>{f(item)}</li>)}
                </ul>
              ),
            )}
          </div>
        </section>
      </li>
    ))}
  </ol>

  <p class="mt-16">
    <a href={getLocalizedUrl(locale)} class="font-semibold">&larr; {t.legal.backHome}</a>
  </p>
</article>
