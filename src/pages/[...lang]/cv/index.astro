---
// CV page. Container only (ADR-0001): it joins the shared data with the
// dictionary, formats the copy and composes the cv/ sections.
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import CvHero from "../../../components/cv/CvHero.astro";
import EducationSection from "../../../components/cv/EducationSection.astro";
import ExperienceSection from "../../../components/cv/ExperienceSection.astro";
import ProjectsSection from "../../../components/cv/ProjectsSection.astro";
import SkillsSection from "../../../components/cv/SkillsSection.astro";
import { education } from "../../../data/education";
import { experience } from "../../../data/experience";
import { experienceYears, profileName, socialLinks, websiteUrl } from "../../../data/profile";
import { projects } from "../../../data/projects";
import { skillCategories } from "../../../data/skills";
import type { Locale } from "../../../i18n/config";
import { formatDeep, getLocaleStaticPaths, useTranslations } from "../../../i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const values = { years: experienceYears };
const meta = formatDeep(t.meta.home, values);

const jobs = experience.map((job) => ({
  company: job.company,
  period: `${job.startYear} - ${job.endYear}`,
  role: t.experience[job.id].role,
  bullets: t.experience[job.id].bullets,
}));
const projectSummaries = projects.map((project) => ({
  title: project.title,
  description: t.projects[project.id].description,
  tags: t.projects[project.id].tags,
  link: project.link,
}));
const educationEntries = education.map((entry) => ({
  institution: entry.institution,
  degree: t.education.entries[entry.id].degree,
  degreeAlt: t.education.entries[entry.id].degreeAlt,
  note:
    "licenseNumber" in entry
      ? `${t.education.graduatedLabel} ${entry.graduationYear} | ${t.education.licenseLabel}: No. ${entry.licenseNumber}`
      : undefined,
}));
const skillGroups = skillCategories.map((category) => ({
  title: t.skills.categories[category.id],
  items: category.items.map((item) => (typeof item === "string" ? item : t.skills.terms[item.term])),
}));
---

<Layout title={meta.title} description={meta.description} image="/favicon.svg">
  <Header />

  <main class="pt-20">
    <CvHero
      copy={formatDeep(t.hero, values)}
      name={profileName}
      avatarSrc="/favicon.svg"
      experienceHref="#experience"
      contactHref={websiteUrl}
      socialLinks={socialLinks}
    />
    <ExperienceSection id="experience" title={t.sections.experience} jobs={jobs} />
    <ProjectsSection id="projects" title={t.sections.featuredProjects} projects={projectSummaries} />
    <EducationSection id="education" title={t.sections.education} entries={educationEntries} />
    <SkillsSection id="skills" title={t.sections.skills} categories={skillGroups} />
  </main>

  <Footer />
</Layout>
