---
// CV projects page. Container only (ADR-0001): projects that have a case study
// render as one, the rest as cards.
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import CaseStudy from "../../../../components/case-study/CaseStudy.astro";
import ProjectsSection from "../../../../components/cv/ProjectsSection.astro";
import PageHeader from "../../../../components/ui/PageHeader.astro";
import Section from "../../../../components/ui/Section.astro";
import { businessPlaceholders } from "../../../../data/business";
import { caseStudies } from "../../../../data/caseStudies";
import { projects } from "../../../../data/projects";
import type { Locale } from "../../../../i18n/config";
import { formatDeep, getLocaleStaticPaths, useTranslations } from "../../../../i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const overrides: Partial<Record<string, string>> = t.projectsPage.descriptionOverrides;

const hasCaseStudy = (id: string): id is keyof typeof caseStudies => id in caseStudies;
const featured = projects
  .map((project) => project.id)
  .filter(hasCaseStudy)
  .map((id) => ({ id, copy: formatDeep(t.caseStudies[id], businessPlaceholders), study: caseStudies[id] }));
const otherProjects = projects
  .filter((project) => !hasCaseStudy(project.id))
  .map((project) => ({
    title: project.title,
    description: overrides[project.id] ?? t.projects[project.id].description,
    tags: t.projects[project.id].tags,
    link: project.link,
  }));
---

<Layout title={t.meta.projects.title} description={t.meta.projects.description}>
  <Header />

  <!-- 120px to the heading: 88px here plus the compact section's 32px. -->
  <main class="min-h-[70vh] pt-[88px]">
    <Section labelledby="projects-title" spacing="compact">
      <PageHeader id="projects-title" title={t.projectsPage.heading} intro={t.projectsPage.intro} />
    </Section>
    {featured.map(({ id, copy, study }) => <CaseStudy id={id} copy={copy} study={study} />)}
    <ProjectsSection id="more-projects" title={t.projectsPage.moreProjects} projects={otherProjects} columns={3} />
  </main>

  <Footer />
</Layout>
