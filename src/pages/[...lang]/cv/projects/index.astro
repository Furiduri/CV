---
// CV projects page. Container only (ADR-0001).
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import ProjectGrid from "../../../../components/cv/ProjectGrid.astro";
import PageHeader from "../../../../components/ui/PageHeader.astro";
import Section from "../../../../components/ui/Section.astro";
import { projects } from "../../../../data/projects";
import type { Locale } from "../../../../i18n/config";
import { getLocaleStaticPaths, useTranslations } from "../../../../i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const overrides: Partial<Record<string, string>> = t.projectsPage.descriptionOverrides;

const projectSummaries = projects.map((project) => ({
  title: project.title,
  description: overrides[project.id] ?? t.projects[project.id].description,
  tags: t.projects[project.id].tags,
  link: project.link,
}));
---

<Layout title={t.meta.projects.title} description={t.meta.projects.description}>
  <Header />

  <!-- 120px to the heading: 88px here plus the compact section's 32px. -->
  <main class="min-h-[70vh] pt-[88px]">
    <Section labelledby="projects-title" spacing="compact">
      <PageHeader id="projects-title" title={t.projectsPage.heading} intro={t.projectsPage.intro} />
      <ProjectGrid projects={projectSummaries} />
    </Section>
  </main>

  <Footer />
</Layout>
