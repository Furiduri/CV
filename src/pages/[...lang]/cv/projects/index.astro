---
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import ProjectCard from "../../../../components/ProjectCard.astro";
import { projects } from "../../../../data/projects";
import type { Locale } from "../../../../i18n/config";
import { getLocaleStaticPaths, useTranslations } from "../../../../i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const overrides: Partial<Record<string, string>> = t.projectsPage.descriptionOverrides;
---


<Layout 
  title={t.meta.projects.title}
  description={t.meta.projects.description}
>
  <Header />
  
  <main class="pt-[120px] container animate-fade-in min-h-[70vh]">
    <h1 class="text-gradient">{t.projectsPage.heading}</h1>
    <p class="text-zinc-400 text-lg mb-12 max-w-[600px]">
      {t.projectsPage.intro}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {projects.map((project) => (
        <ProjectCard 
          title={project.title}
          description={overrides[project.id] ?? t.projects[project.id].description}
          tags={t.projects[project.id].tags}
          link={project.link}
        />
      ))}
    </div>
  </main>

  <Footer />
</Layout>
