---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import LegalDocument from "../../../components/legal/LegalDocument.astro";
import { businessPlaceholders, legalLastUpdated } from "../../../data/business";
import type { Locale } from "../../../i18n/config";
import { format, formatDeep, getLocaleStaticPaths, getLocalizedUrl, useTranslations } from "../../../i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  title={t.meta.terms.title}
  description={format(t.meta.terms.description, businessPlaceholders)}
>
  <Header variant="landing" />

  <main class="pt-32 pb-8 container">
    <LegalDocument
      document={formatDeep(t.legal.terms, businessPlaceholders)}
      labels={t.legal}
      updatedIso={legalLastUpdated}
      homeHref={getLocalizedUrl(lang)}
    />
  </main>

  <Footer variant="landing" />
</Layout>
