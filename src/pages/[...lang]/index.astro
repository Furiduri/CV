---
// GCatcode landing. Container only (ADR-0001): it resolves the locale, formats
// the copy, builds the links and composes the sections.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CaseStudy from "../../components/case-study/CaseStudy.astro";
import AboutSection from "../../components/landing/AboutSection.astro";
import FaqSection from "../../components/landing/FaqSection.astro";
import FinalCtaSection from "../../components/landing/FinalCtaSection.astro";
import FreeCallSection from "../../components/landing/FreeCallSection.astro";
import LandingHero from "../../components/landing/LandingHero.astro";
import MethodSection from "../../components/landing/MethodSection.astro";
import ProblemSection from "../../components/landing/ProblemSection.astro";
import ServicesSection from "../../components/landing/ServicesSection.astro";
import TrustSection from "../../components/landing/TrustSection.astro";
import PhotoCredits from "../../components/ui/PhotoCredits.astro";
import { business, businessPlaceholders, mailtoUrl, whatsappUrl } from "../../data/business";
import { caseStudies } from "../../data/caseStudies";
import { landingPhotos, unsplashUrl } from "../../data/landingPhotos";
import { experienceYears } from "../../data/profile";
import type { Locale } from "../../i18n/config";
import { formatDeep, getLocaleStaticPaths, getLocalizedUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const values = { ...businessPlaceholders, years: experienceYears };
const l = formatDeep(t.landing, values);
const meta = formatDeep(t.meta.landing, values);

const links = {
  whatsapp: whatsappUrl(l.whatsappMessages.general),
  freeCall: whatsappUrl(l.whatsappMessages.freeCall),
  advisory: whatsappUrl(l.whatsappMessages.advisory),
  terms: getLocalizedUrl(lang, "terminos"),
  privacy: getLocalizedUrl(lang, "privacidad"),
  cv: getLocalizedUrl(lang, "cv"),
};
const photoAuthors = Object.values(landingPhotos).map((photo) => ({ name: photo.author, url: photo.authorUrl }));
---

<Layout title={meta.title} description={meta.description}>
  <Header variant="landing" />

  <main class="pt-20">
    <LandingHero
      copy={l.hero}
      photo={landingPhotos.hero}
      photoAlt={l.images.hero}
      chips={{
        offer: { title: l.freeCall.badge, text: l.freeCall.details[0] ?? "" },
        delivery: l.method.points.cycles.title,
      }}
      primaryHref={links.whatsapp}
      secondaryHref="#free-call"
      newTabLabel={l.newTabNote}
    />
    <ProblemSection copy={l.problem} photo={landingPhotos.problem} photoAlt={l.images.problem} />
    <ServicesSection id="services" copy={l.services} photo={landingPhotos.services} photoAlt={l.images.services} />
    <MethodSection id="method" copy={l.method} photo={landingPhotos.method} photoAlt={l.images.method} />
    <CaseStudy id="case-study" copy={formatDeep(t.caseStudies.juegalajara, values)} study={caseStudies.juegalajara} />
    <TrustSection copy={l.trust} privacyHref={links.privacy} termsHref={links.terms} />
    <AboutSection id="about" copy={l.about} avatarSrc="/favicon.svg" cvHref={links.cv} />
    <FreeCallSection
      id="free-call"
      copy={l.freeCall}
      freeCallHref={links.freeCall}
      advisoryHref={links.advisory}
      newTabLabel={l.newTabNote}
    />
    <FaqSection id="faq" copy={l.faq} termsHref={links.terms} privacyHref={links.privacy} />
    <FinalCtaSection
      copy={l.finalCta}
      photo={landingPhotos.finalCta}
      ctaHref={links.whatsapp}
      email={business.email}
      emailHref={mailtoUrl}
      newTabLabel={l.newTabNote}
    >
      <PhotoCredits
        slot="footnote"
        lang={lang}
        lead={l.photoCredits.lead}
        on={l.photoCredits.on}
        authors={photoAuthors}
        source={{ name: "Unsplash", url: unsplashUrl }}
      />
    </FinalCtaSection>
  </main>

  <Footer variant="landing" />
</Layout>
