---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon, { type IconName } from "../../components/Icon.astro";
import TechPill from "../../components/TechPill.astro";
import juegalajaraDesktop from "../../assets/case-study/juegalajara-desktop.png";
import juegalajaraMobile from "../../assets/case-study/juegalajara-mobile.jpg";
import { businessPlaceholders, caseStudy, mailtoUrl, business, whatsappUrl } from "../../data/business";
import { education } from "../../data/education";
import { landingPhotos, unsplashUrl } from "../../data/landingPhotos";
import { experienceYears } from "../../data/profile";
import type { Locale } from "../../i18n/config";
import { format, getLocaleStaticPaths, getLocalizedUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const l = t.landing;

const license = education.find((entry) => "licenseNumber" in entry)?.licenseNumber ?? "";
const values = { ...businessPlaceholders, years: experienceYears, license };
const f = (text: string) => format(text, values);

const whatsapp = {
  general: whatsappUrl(f(l.whatsappMessages.general)),
  freeCall: whatsappUrl(f(l.whatsappMessages.freeCall)),
  advisory: whatsappUrl(f(l.whatsappMessages.advisory)),
};
const termsUrl = getLocalizedUrl(lang, "terminos");
const privacyUrl = getLocalizedUrl(lang, "privacidad");
const cvUrl = getLocalizedUrl(lang, "cv");
const caseStudyHost = new URL(caseStudy.url).host;

const problemIcons: IconName[] = ["arrowPath", "chats", "currency"];
const services: { icon: IconName; item: { title: string; text: string } }[] = [
  { icon: "globe", item: l.services.items.web },
  { icon: "phone", item: l.services.items.mobile },
  { icon: "desktop", item: l.services.items.desktop },
  { icon: "academic", item: l.services.items.advisory },
];
const methodPoints: { icon: IconName; item: { title: string; text: string } }[] = [
  { icon: "clock", item: l.method.points.cycles },
  { icon: "checkCircle", item: l.method.points.results },
  { icon: "arrowPath", item: l.method.points.flexibility },
];
const faqItems = [
  { item: l.faq.items.freeCall },
  { item: l.faq.items.inPerson },
  { item: l.faq.items.advisoryPrice },
  { item: l.faq.items.projectPayment },
  { item: l.faq.items.warranty, link: { href: termsUrl, label: l.faq.termsLink } },
  { item: l.faq.items.ai, link: { href: privacyUrl, label: l.faq.privacyLink } },
];

// Photo credits joined the way each locale writes a list ("A, B y C" / "A, B, and C").
const photos = Object.values(landingPhotos);
let authorIndex = 0;
const credits = new Intl.ListFormat(lang, { type: "conjunction" })
  .formatToParts(photos.map((photo) => photo.author))
  .map((part) => (part.type === "element" ? { text: part.value, url: photos[authorIndex++]?.authorUrl } : { text: part.value }));
const creditLink = "text-zinc-200 underline underline-offset-2 hover:text-brand-neon";

const iconBadge = "inline-flex items-center justify-center w-12 h-12 shrink-0 rounded-xl bg-brand-base/10 text-brand-neon border border-brand-base/20";
---

<Layout title={t.meta.landing.title} description={f(t.meta.landing.description)}>
  <Header variant="landing" />

  <main class="pt-20">
    <!-- HERO -->
    <section class="relative overflow-hidden" aria-labelledby="hero-title">
      <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-10 h-[32rem] w-[32rem] rounded-full bg-teal-400/10 blur-[120px]"></div>
      <div class="container grid grid-cols-1 lg:grid-cols-12 gap-14 items-center lg:min-h-[78vh]">
        <div class="lg:col-span-7 text-center lg:text-left">
          <p class="eyebrow">{l.hero.eyebrow}</p>
          <h1 id="hero-title" class="text-4xl md:text-6xl">
            <span class="text-gradient">{l.hero.title}</span>
          </h1>
          <p class="max-w-2xl text-lg md:text-xl text-zinc-200 mb-10 leading-relaxed mx-auto lg:mx-0">{f(l.hero.subtitle)}</p>
          <div class="flex flex-col sm:flex-row flex-wrap gap-4 justify-center lg:justify-start">
            <a href={whatsapp.general} target="_blank" rel="noopener" class="btn-cta">
              <Icon name="chat" class="w-5 h-5" />
              {l.hero.primaryCta}<span class="sr-only"> {l.newTabNote}</span>
            </a>
            <a href="#free-call" class="btn-outline">{l.hero.secondaryCta}</a>
          </div>
          <p class="text-sm text-zinc-300 mt-6 mb-0 max-w-2xl mx-auto lg:mx-0">{f(l.hero.note)}</p>
        </div>

        <div class="lg:col-span-5 relative mx-auto w-full max-w-sm lg:max-w-none">
          <div class="photo-frame aspect-[4/5]">
            <Image
              src={landingPhotos.hero.src}
              width={landingPhotos.hero.width}
              height={landingPhotos.hero.height}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 440px, (min-width: 640px) 384px, 90vw"
              alt={l.images.hero}
              loading="eager"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent"></div>
          </div>
          <div class="chip absolute left-3 bottom-6 lg:-left-10 lg:bottom-12">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-neon text-zinc-950"><Icon name="chat" class="w-5 h-5" /></span>
            <p class="m-0 text-sm font-bold text-zinc-50 leading-snug">{l.freeCall.badge}<span class="block font-normal text-zinc-300">{f(l.freeCall.details[0] ?? "")}</span></p>
          </div>
          <div class="chip absolute right-3 top-6 max-w-[15rem] lg:-right-6 lg:top-10">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-base/15 text-brand-neon border border-brand-base/30"><Icon name="clock" class="w-5 h-5" /></span>
            <p class="m-0 text-sm font-bold text-zinc-50 leading-snug">{f(l.method.points.cycles.title)}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="container" aria-labelledby="problem-title">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="photo-frame aspect-[4/3] order-last lg:order-first">
          <Image
            src={landingPhotos.problem.src}
            width={landingPhotos.problem.width}
            height={landingPhotos.problem.height}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 540px, 92vw"
            alt={l.images.problem}
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
        <div>
          <h2 id="problem-title" class="section-heading">{l.problem.title}</h2>
          <p class="text-lg text-zinc-300 mb-10">{l.problem.intro}</p>
          <ul class="flex flex-col gap-8 list-none m-0 p-0">
            {l.problem.items.map((item, index) => (
              <li class="flex gap-5">
                <span class={iconBadge}><Icon name={problemIcons[index] ?? "checkCircle"} /></span>
                <div>
                  <h3 class="text-xl mb-1">{item.title}</h3>
                  <p class="text-zinc-300 m-0">{item.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="band" aria-labelledby="services-title">
      <div class="container">
        <div class="max-w-3xl mb-12">
          <h2 id="services-title" class="section-heading">{l.services.title}</h2>
          <p class="text-lg text-zinc-300 m-0">{l.services.intro}</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <div class="photo-frame lg:col-span-4 aspect-[4/3] lg:aspect-auto lg:min-h-full">
            <Image
              src={landingPhotos.services.src}
              width={landingPhotos.services.width}
              height={landingPhotos.services.height}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 360px, 92vw"
              alt={l.images.services}
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
          <ul class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-6 list-none m-0 p-0">
            {services.map(({ icon, item }) => (
              <li class="glass-card">
                <span class={`${iconBadge} mb-4`}><Icon name={icon} /></span>
                <h3 class="text-xl">{item.title}</h3>
                <p class="text-zinc-300 m-0">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- METHOD -->
    <section id="method" class="container" aria-labelledby="method-title">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <h2 id="method-title" class="section-heading">{l.method.title}</h2>
          <p class="text-lg text-zinc-300 mb-10">{l.method.intro}</p>
          <ol class="flex flex-col gap-8 list-none m-0 p-0 ml-6 border-l border-white/10">
            {methodPoints.map(({ icon, item }) => (
              <li class="relative pl-10">
                <span class="absolute -left-6 top-0 flex h-12 w-12 items-center justify-center rounded-full bg-zinc-950 text-brand-neon border border-brand-base/40"><Icon name={icon} /></span>
                <h3 class="text-xl mb-1 pt-2">{f(item.title)}</h3>
                <p class="text-zinc-300 m-0">{f(item.text)}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="photo-frame aspect-[4/3]">
          <Image
            src={landingPhotos.method.src}
            width={landingPhotos.method.width}
            height={landingPhotos.method.height}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 540px, 92vw"
            alt={l.images.method}
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- CASE STUDY -->
    <section id="case-study" class="band relative overflow-hidden" aria-labelledby="case-study-title">
      <div aria-hidden="true" class="pointer-events-none absolute -left-40 top-1/3 h-[28rem] w-[28rem] rounded-full bg-brand-base/10 blur-[120px]"></div>
      <div class="container relative">
        <div class="max-w-3xl mb-12">
          <p class="eyebrow">{l.caseStudy.eyebrow}</p>
          <h2 id="case-study-title" class="text-zinc-50">{l.caseStudy.title}</h2>
          <p class="text-lg text-zinc-300 m-0">{l.caseStudy.intro}</p>
        </div>

        <div class="relative mb-20 pr-10 sm:pr-24 lg:pr-36">
          <figure class="m-0 overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 shadow-2xl shadow-black/60">
            <div aria-hidden="true" class="flex items-center gap-2 border-b border-white/10 bg-zinc-900 px-4 py-3">
              <span class="h-3 w-3 rounded-full bg-zinc-700"></span>
              <span class="h-3 w-3 rounded-full bg-zinc-700"></span>
              <span class="h-3 w-3 rounded-full bg-zinc-700"></span>
              <span class="ml-3 w-full max-w-xs truncate rounded-md bg-zinc-800 px-3 py-1 text-xs text-zinc-300">{caseStudyHost}</span>
            </div>
            <Image
              src={juegalajaraDesktop}
              widths={[640, 960, 1440]}
              sizes="(min-width: 1152px) 920px, 85vw"
              alt={l.images.caseStudyDesktop}
              class="block h-auto w-full"
            />
          </figure>
          <div class="absolute -bottom-10 right-0 w-24 sm:w-40 lg:w-48 rounded-[1.75rem] border-4 border-zinc-800 bg-zinc-800 shadow-2xl shadow-black/70 overflow-hidden">
            <Image
              src={juegalajaraMobile}
              widths={[200, 400]}
              sizes="(min-width: 1024px) 192px, (min-width: 640px) 160px, 96px"
              alt={l.images.caseStudyMobile}
              class="block h-auto w-full rounded-[1.4rem]"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="glass-card">
            <h3 class="text-xl">{l.caseStudy.challengeLabel}</h3>
            <p class="text-zinc-300 m-0">{l.caseStudy.challenge}</p>
          </div>
          <div class="glass-card">
            <h3 class="text-xl">{l.caseStudy.solutionLabel}</h3>
            <p class="text-zinc-300 mb-4">{l.caseStudy.solution}</p>
            <ul class="list-none m-0 p-0 space-y-2 text-zinc-200">
              {l.caseStudy.features.map((feature) => (
                <li class="flex gap-2"><Icon name="check" class="w-5 h-5 shrink-0 mt-0.5 text-brand-neon" />{feature}</li>
              ))}
            </ul>
          </div>
          <div class="glass-card flex flex-col">
            <h3 class="text-xl">{l.caseStudy.resultLabel}</h3>
            <p class="text-zinc-300 mb-6">{l.caseStudy.result}</p>
            <h4 class="text-sm uppercase tracking-wider text-zinc-300 mb-2">{l.caseStudy.stackLabel}</h4>
            <div class="flex flex-wrap gap-2 mb-6">
              {caseStudy.stack.map((tech) => <TechPill name={tech} />)}
            </div>
            <a href={caseStudy.url} target="_blank" rel="noopener" class="link mt-auto inline-flex items-center gap-2">
              {l.caseStudy.linkLabel}
              <Icon name="external" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST -->
    <section class="container" aria-labelledby="trust-title">
      <div class="max-w-3xl mb-12">
        <h2 id="trust-title" class="section-heading">{l.trust.title}</h2>
        <p class="text-lg text-zinc-300 m-0">{l.trust.intro}</p>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none m-0 p-0">
        <li class="glass-card">
          <span class={`${iconBadge} mb-4`}><Icon name="shield" /></span>
          <h3 class="text-xl">{l.trust.privacy.title}</h3>
          <p class="text-zinc-300 m-0">{l.trust.privacy.text} <a href={privacyUrl} class="link">{l.trust.privacy.linkLabel}</a>.</p>
        </li>
        <li class="glass-card">
          <span class={`${iconBadge} mb-4`}><Icon name="eye" /></span>
          <h3 class="text-xl">{l.trust.review.title}</h3>
          <p class="text-zinc-300 m-0">{l.trust.review.text}</p>
        </li>
        <li class="glass-card">
          <span class={`${iconBadge} mb-4`}><Icon name="checkCircle" /></span>
          <h3 class="text-xl">{f(l.trust.warranty.title)}</h3>
          <p class="text-zinc-300 mb-4">{f(l.trust.warranty.text)}</p>
          <a href={termsUrl} class="link">{l.trust.warranty.linkLabel}</a>
        </li>
      </ul>
    </section>

    <!-- ABOUT ME -->
    <section id="about" class="container" aria-labelledby="about-title">
      <div class="glass-card hover:!translate-y-0 flex flex-col md:flex-row items-center md:items-start gap-8 text-center md:text-left">
        <div class="relative shrink-0">
          <div class="absolute -inset-1 bg-gradient-to-r from-brand-base to-brand-neon rounded-full blur opacity-25"></div>
          <div class="relative w-32 h-32 md:w-40 md:h-40 rounded-full border-4 border-zinc-900 bg-zinc-800 overflow-hidden shadow-2xl flex items-center justify-center p-4">
            <img src="/favicon.svg" alt={l.about.avatarAlt} width="128" height="128" class="w-full h-full object-contain" loading="lazy" />
          </div>
        </div>
        <div>
          <h2 id="about-title" class="text-zinc-50">{l.about.title}</h2>
          <p class="text-lg text-zinc-200 mb-4">{f(l.about.intro)}</p>
          <p class="text-zinc-300 mb-8">
            <strong class="text-zinc-50">{l.about.missionLabel}:</strong> {l.about.mission}
          </p>
          <a href={cvUrl} class="btn-outline">{l.about.cvLink}</a>
        </div>
      </div>
    </section>

    <!-- FREE CALL + PAID ADVISORY -->
    <section id="free-call" class="container" aria-labelledby="free-call-title">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <div class="glass-card hover:!translate-y-0 lg:col-span-3 !border-brand-base/40 bg-gradient-to-br from-brand-base/15 via-zinc-900/60 to-zinc-900/60">
          <span class="inline-block bg-brand-neon text-zinc-950 px-3 py-1 rounded-full text-sm font-bold mb-4">{l.freeCall.badge}</span>
          <h2 id="free-call-title" class="text-zinc-50">{l.freeCall.title}</h2>
          <p class="text-lg text-zinc-200 mb-6">{f(l.freeCall.text)}</p>
          <ul class="list-none m-0 p-0 mb-8 flex flex-col sm:flex-row flex-wrap gap-x-6 gap-y-2 text-zinc-100">
            {l.freeCall.details.map((detail) => (
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 shrink-0 mt-0.5 text-brand-neon" />{f(detail)}</li>
            ))}
          </ul>
          <a href={whatsapp.freeCall} target="_blank" rel="noopener" class="btn-cta">
            {l.freeCall.cta}<span class="sr-only"> {l.newTabNote}</span>
          </a>
        </div>
        <div class="glass-card hover:!translate-y-0 lg:col-span-2 flex flex-col">
          <h3 class="text-2xl">{l.freeCall.advisory.title}</h3>
          <p class="mb-4">
            <span class="font-heading font-black text-4xl text-zinc-50">{f(l.freeCall.advisory.price)}</span>
            <span class="text-zinc-300"> {l.freeCall.advisory.unit}</span>
            <span class="block text-sm font-semibold text-brand-neon">{l.freeCall.advisory.taxNote}</span>
          </p>
          <p class="text-zinc-300 mb-3">{l.freeCall.advisory.intro}</p>
          <ul class="list-disc pl-5 space-y-2 text-zinc-200 mb-8 marker:text-brand-neon">
            {l.freeCall.advisory.examples.map((example) => <li>{example}</li>)}
          </ul>
          <a href={whatsapp.advisory} target="_blank" rel="noopener" class="btn-outline mt-auto">
            {l.freeCall.advisory.cta}<span class="sr-only"> {l.newTabNote}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="container max-w-4xl" aria-labelledby="faq-title">
      <h2 id="faq-title" class="section-heading mb-8">{l.faq.title}</h2>
      <div class="flex flex-col gap-4">
        {faqItems.map(({ item, link }) => (
          <details class="group glass-card !p-0 hover:!translate-y-0">
            <summary class="flex justify-between items-center gap-4 cursor-pointer list-none p-6 font-heading font-bold text-lg text-zinc-50 [&::-webkit-details-marker]:hidden">
              {item.question}
              <Icon name="chevronDown" class="w-5 h-5 shrink-0 text-brand-neon transition-transform group-open:rotate-180" />
            </summary>
            <div class="px-6 pb-6 text-zinc-300">
              <p class="m-0">{f(item.answer)}</p>
              {link && <a href={link.href} class="link inline-block mt-3">{link.label}</a>}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="container" aria-labelledby="final-cta-title">
      <div class="relative isolate overflow-hidden rounded-3xl border border-white/10">
        <Image
          src={landingPhotos.finalCta.src}
          width={landingPhotos.finalCta.width}
          height={landingPhotos.finalCta.height}
          widths={[640, 1200, 2400]}
          sizes="(min-width: 1152px) 1088px, 92vw"
          alt=""
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-zinc-950 via-zinc-950/85 to-zinc-950/70"></div>
        <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-base/20 to-transparent"></div>
        <div class="px-6 py-16 md:px-12 md:py-24 text-center">
          <h2 id="final-cta-title" class="text-zinc-50 text-3xl md:text-5xl">{l.finalCta.title}</h2>
          <p class="text-lg md:text-xl text-zinc-100 max-w-2xl mx-auto mb-10">{l.finalCta.text}</p>
          <a href={whatsapp.general} target="_blank" rel="noopener" class="btn-cta">
            <Icon name="chat" class="w-5 h-5" />
            {l.finalCta.cta}<span class="sr-only"> {l.newTabNote}</span>
          </a>
          <p class="text-zinc-100 mt-8 mb-0">
            {l.finalCta.emailLabel} <a href={mailtoUrl} class="link">{business.email}</a>
          </p>
        </div>
      </div>
      <p class="mt-6 mb-0 text-center text-sm text-zinc-300">
        {l.photoCredits.lead}{" "}
        {credits.map(({ text, url }) => (url ? <a href={url} target="_blank" rel="noopener" class={creditLink}>{text}</a> : text))}{" "}
        {l.photoCredits.on} <a href={unsplashUrl} target="_blank" rel="noopener" class={creditLink}>Unsplash</a>.
      </p>
    </section>
  </main>

  <Footer variant="landing" />
</Layout>
