---
// Brand fonts are self-hosted (ADR-0002): bundled from npm, never requested
// from a third-party CDN.
import "@fontsource-variable/inter";
import "@fontsource-variable/outfit";
import "../styles/global.css";
import { defaultLocale, hreflangByLocale, locales } from "../i18n/config";
import { getLocalizedUrl, getUnlocalizedPath, resolveLocale } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = "Jorge Osvaldo Perez Mendoza - Portfolio",
  image = "/CVBanner.jpg",
  type = "website",
} = Astro.props;

const url = Astro.url;
const locale = resolveLocale(Astro.currentLocale);
const canonicalURL = new URL(url.pathname, Astro.site || url.origin);

// Same route in every configured locale, for hreflang alternates.
const unlocalizedPath = getUnlocalizedPath(url.pathname);
const alternates = locales.map((alternateLocale) => ({
  hreflang: hreflangByLocale[alternateLocale],
  href: new URL(getLocalizedUrl(alternateLocale, unlocalizedPath), Astro.site || url.origin),
}));
const defaultAlternate = new URL(getLocalizedUrl(defaultLocale, unlocalizedPath), Astro.site || url.origin);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternate languages -->
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultAlternate} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="image" content={new URL(image, Astro.site || url.origin)} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(image, Astro.site || url.origin)}
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={new URL(image, Astro.site || url.origin)}
    />
  </head>
  <body class="min-h-screen">
    <div class="fixed inset-0 -z-10 h-full w-full bg-zinc-950">
      <div class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
      <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-brand-base opacity-20 blur-[100px]"></div>
    </div>
    
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
